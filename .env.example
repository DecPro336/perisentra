# Copy to .env and fill in SNOWFLAKE_ACCOUNT. Never commit .env (it is git-ignored).
PERISENTRA_DATA_DIR=./data
PERISENTRA_LOG_LEVEL=INFO
# The drop shared with the retailer: inbound/ (source extracts + manifests), outbound/ (store task lists).
# PERISENTRA_EXCHANGE_DIR=./exchange

# Warehouse: snowflake, or duckdb for the offline copy in data/warehouse (no network; the tests always use it).
# Selects the dbt target AND where ingestion and the models read and write.
PERISENTRA_DBT_TARGET=snowflake

# Snowflake (one-time setup: warehouse/snowflake/README.md). Key-pair authentication: no password anywhere.
SNOWFLAKE_ACCOUNT=                      # organisation-account, e.g. ABCDEFG-XY12345
SNOWFLAKE_USER=PERISENTRA_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/perisentra_rsa_key.p8
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_DATABASE=PERISENTRA
SNOWFLAKE_WAREHOUSE=TRANSFORM_WH

# Dashboard -> API
API_URL=http://localhost:8000
PERISENTRA_MLFLOW_UI=http://localhost:5000
